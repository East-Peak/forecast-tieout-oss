{
  "name": "forecast-tieout-frontend",
  "version": "0.1.0",
  "description": "Forecast Tieout: Reconcile the revenue plan against pipeline reality.",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:data": "node ./scripts/sync-data.mjs",
    "editor:assets": "node ./scripts/build-editor-assets.mjs",
    "dev": "npm run sync:data && npm run editor:assets && vite",
    "build": "npm run sync:data && npm run editor:assets && tsc && vite build",
    "preview": "npm run sync:data && vite preview",
    "test": "vitest",
    "test:e2e": "npm run build && playwright test --grep @smoke",
    "screenshots": "node ./scripts/capture-screenshots.mjs",
    "knip": "knip",
    "verify": "knip && vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "@vercel/analytics": "^2.0.1",
    "pyodide": "314.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "15.0.4",
    "knip": "^6.24.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^5.1.2"
  }
}
