# Frontend Configuration
# Defaults to /data, which serves frontend/public/data in static/Vercel mode.
# VITE_DATA_BASE_URL=/data

# Protected mode (optional; unset for the public static demo)
# VITE_SUPABASE_URL=                          # Supabase project URL (for protected mode)
# VITE_SUPABASE_ANON_KEY=                     # Supabase anon key (for protected mode)
# VITE_ALLOWED_EMAIL_DOMAINS=example.com      # Comma-separated allowed domains (optional)

# Supabase Storage (for cloud deploy path)
# SUPABASE_PROJECT_REF=                        # Supabase project ID
# SUPABASE_SERVICE_ROLE_KEY=                   # Service role key (for CI uploads)
