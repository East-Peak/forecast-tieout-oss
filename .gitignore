# Real org data: only the three synthetic demo companies are tracked. Anything else
# under engine/data-v2/, engine/config/profiles/ or the reports directory stays out of
# git unless you deliberately commit it.
engine/data-v2/*/
!engine/data-v2/sprout-labs/
!engine/data-v2/sapling-industries/
!engine/data-v2/mighty-oak-holdings/

engine/config/profiles/*/
!engine/config/profiles/sprout-labs/
!engine/config/profiles/sapling-industries/
!engine/config/profiles/mighty-oak-holdings/

frontend/public/data/reports/*/
!frontend/public/data/reports/sprout-labs/
!frontend/public/data/reports/sapling-industries/
!frontend/public/data/reports/mighty-oak-holdings/
.vercel
